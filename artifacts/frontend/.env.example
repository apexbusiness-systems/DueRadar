# Required — Clerk publishable key (get from clerk.com dashboard)
VITE_CLERK_PUBLISHABLE_KEY=pk_live_...

# Optional — custom Clerk proxy for production domains
# VITE_CLERK_PROXY_URL=https://yourdomain.com/api/__clerk

# Optional — Sentry DSN for frontend error reporting
# VITE_SENTRY_DSN=https://...@sentry.io/...

# Do NOT set VITE_TEST_BYPASS_AUTH=true in production.
# It is only for local E2E test runs against a test Clerk environment.
