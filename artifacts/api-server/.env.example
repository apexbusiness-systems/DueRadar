# Required
PORT=3001
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/dueradar
CLERK_SECRET_KEY=sk_live_...
CLERK_PUBLISHABLE_KEY=pk_live_...
ALLOWED_ORIGINS=https://yourdomain.com

# Webhooks
CLERK_WEBHOOK_SECRET=whsec_...
FLOWC_WEBHOOK_SECRET=whsec_...

# Optional integrations
# FLOWC_WORKSPACE_ID=1
# FLOWC_CALLBACK_URL=https://yourdomain.com/api/internal/flowc/callback

# SMTP (required for reminder emails)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=no-reply@example.com
SMTP_PASS=...
SMTP_FROM=DueRadar <no-reply@example.com>

# Observability
# SENTRY_DSN=https://...@sentry.io/...

# Feature flags
# ENABLE_REMINDER_SCHEDULER=true
# DEMO_DATA_MODE=true
