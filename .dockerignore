# Git
.git
.gitignore

# Dependencies — reinstalled during build
**/node_modules

# Compiled output — rebuilt during build
**/dist
**/*.tsbuildinfo

# Frontend source — not needed for the API server build
artifacts/frontend/src
artifacts/frontend/public
artifacts/frontend/index.html
artifacts/frontend/vite.config.ts
artifacts/frontend/tsconfig.json
artifacts/frontend/components.json
artifacts/frontend/.replit-artifact

# Secrets and local config
.env
.env.*
!.env.example

# Dev tooling
.vscode
.idea
coverage
**/*.md

# Root icon assets are not required for API image build
public/assets
